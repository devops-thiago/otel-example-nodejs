{
  "name": "otel-example-nodejs",
  "version": "1.0.0",
  "description": "Node.js Express CRUD API with OpenTelemetry instrumentation",
  "main": "src/server.js",
  "scripts": {
    "start": "node -r ./src/instrumentation.js src/server.js",
    "start:custom-otel": "node -r ./src/instrumentation.js src/server.js",
    "dev": "NODE_ENV=development nodemon -r ./src/instrumentation.js src/server.js",
    "test": "NODE_ENV=test jest --coverage --runInBand",
    "test:unit": "NODE_ENV=test jest --config jest.unit.config.js --coverage --runInBand",
    "test:integration": "NODE_ENV=test jest --config jest.integration.config.js --coverage --runInBand",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:watch:unit": "NODE_ENV=test jest --config jest.unit.config.js --watch",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "docker:build": "docker build -t otel-example-nodejs .",
    "docker:build:push": "docker build -t thiagosg/otel-crud-api-nodejs:latest -t thiagosg/otel-crud-api-nodejs:1.0.0 . && docker push thiagosg/otel-crud-api-nodejs:latest && docker push thiagosg/otel-crud-api-nodejs:1.0.0",
    "docker:push": "docker push thiagosg/otel-crud-api-nodejs:latest && docker push thiagosg/otel-crud-api-nodejs:1.0.0",
    "docker:tag": "docker tag otel-example-nodejs thiagosg/otel-crud-api-nodejs:latest && docker tag otel-example-nodejs thiagosg/otel-crud-api-nodejs:1.0.0",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down -v",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "opentelemetry",
    "express",
    "crud",
    "observability",
    "tracing",
    "metrics",
    "logging"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.219.0",
    "@opentelemetry/instrumentation": "^0.219.0",
    "@opentelemetry/instrumentation-express": "^0.67.0",
    "@opentelemetry/instrumentation-http": "^0.219.0",
    "@opentelemetry/instrumentation-mysql2": "^0.65.0",
    "@opentelemetry/resources": "^2.4.0",
    "@opentelemetry/sdk-metrics": "^2.4.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "joi": "^18.2.3",
    "mysql2": "^3.23.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "js-yaml": "^4.2.0",
    "micromatch": {
      "picomatch": "^2.3.2"
    },
    "anymatch": {
      "picomatch": "^2.3.2"
    },
    "readdirp": {
      "picomatch": "^2.3.2"
    },
    "jest-util": {
      "picomatch": "^4.0.4"
    }
  }
}
